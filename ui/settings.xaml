<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="grab settings"
        Icon="__GRAB_ASSETS__/icon.ico"
        Width="520" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="440" MinHeight="520"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <!--
    Arcade + Silkscreen + VHS
    ==========================
    Same tokens as popup.xaml. Silkscreen for wordmark + micro-uppercase.
    VT323 for section headers + labels. Inter for readable body / captions.
    __GRAB_FONTS__ and __GRAB_THEME__ tokens substituted at load time in
    settings.ps1 (see popup.xaml for the same pattern).
    Every ComboBox, Slider, CheckBox, TextBox references the shared theme
    styles (ArcadeCombo, ArcadeSlider, ArcadeCheck, ArcadeText) so no
    Windows-native chrome leaks through.
  -->

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- __GRAB_THEME__ is substituted with the file URI of ui/theme.xaml -->
        <ResourceDictionary Source="__GRAB_THEME__"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Local styles: field label + settings-window title-bar icons only. -->
      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="__GRAB_FONTS__#Inter"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>

      <!-- Icon-only button (min/close) -->
      <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        <Setter Property="FontFamily" Value="__GRAB_FONTS__#Silkscreen"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Rec}"/>
                  <Setter Property="Foreground" Value="White"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="14">
    <!-- Mockup radius 14 + inset pink halo (nested Border trick; see popup.xaml
         for the rationale). #26FF2E93 = 15% pink for the inset glow effect. -->
    <Border CornerRadius="14"
            Background="{StaticResource Ground}"
            BorderBrush="{StaticResource BorderSoft}"
            BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="60" ShadowDepth="30" Opacity="0.5"/>
      </Border.Effect>

      <Border x:Name="InsetGlow"
              CornerRadius="14"
              BorderThickness="1"
              BorderBrush="#0DFF2E93"
              ClipToBounds="True">

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>   <!-- title bar -->
          <RowDefinition Height="*"/>    <!-- scroll body -->
          <RowDefinition Height="Auto"/> <!-- action row -->
        </Grid.RowDefinitions>

        <!-- Title bar: GRAB wordmark (3-layer chromatic aberration) + subtitle -->
        <Grid Grid.Row="0" x:Name="TitleBar" Background="#01000000" Margin="14,0,4,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- GRAB wordmark, 4-layer stack: amber halo + VHS chromatic
                 aberration (cyan/pink) + cream ink on top. -->
            <Grid Width="100" Height="26" VerticalAlignment="Center">
              <TextBlock Text="GRAB" FontFamily="__GRAB_FONTS__#Silkscreen" FontWeight="Bold" FontSize="18"
                         Foreground="Transparent" TextOptions.TextRenderingMode="Aliased"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect>
                  <DropShadowEffect Color="#FFD447" BlurRadius="16" ShadowDepth="0" Opacity="0.55"/>
                </TextBlock.Effect>
              </TextBlock>
              <TextBlock Text="GRAB" FontFamily="__GRAB_FONTS__#Silkscreen" FontWeight="Bold" FontSize="18"
                         Foreground="{StaticResource Cyan}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="-3,0,0,0" Opacity="0.85"/>
              <TextBlock Text="GRAB" FontFamily="__GRAB_FONTS__#Silkscreen" FontWeight="Bold" FontSize="18"
                         Foreground="{StaticResource Accent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="3,0,0,0" Opacity="0.85"/>
              <TextBlock Text="GRAB" FontFamily="__GRAB_FONTS__#Silkscreen" FontWeight="Bold" FontSize="18"
                         Foreground="{StaticResource Text}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="SETTINGS" FontFamily="__GRAB_FONTS__#VT323" FontSize="14"
                       Foreground="{StaticResource TextMuted}"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <!-- Content="__" is the WPF escape for a literal underscore
                 glyph. A single "_" was treated as an access-key marker and
                 rendered as an empty button (audit v0.3.0-pass2 P0-3). -->
            <Button x:Name="MinBtn"   Style="{StaticResource IconBtn}"  Content="__"
                    AutomationProperties.Name="Minimize"
                    ToolTip="Minimize"/>
            <Button x:Name="CloseBtn" Style="{StaticResource CloseBtn}" Content="X" Margin="4,0,0,0"
                    IsCancel="True"
                    AutomationProperties.Name="Close"
                    ToolTip="Close (Esc)"/>
          </StackPanel>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,4,24,0">
          <StackPanel>

            <!-- Downloads section -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="DOWNLOADS"/>
            <Border Height="1" Background="{StaticResource Cyan}" Opacity="0.35" Margin="0,-4,0,10"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Default download folder"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox   Grid.Column="0" x:Name="DownloadFolder" Style="{StaticResource ArcadeText}"
                         AutomationProperties.Name="Default download folder"/>
              <Button    Grid.Column="1" x:Name="BrowseBtn" Style="{StaticResource ArcadeGhost}" Content="BROWSE" Margin="8,0,0,0"
                         AutomationProperties.Name="Browse for download folder"/>
            </Grid>

            <CheckBox x:Name="AskBeforeEach" Style="{StaticResource ArcadeCheck}"
                      Content="Ask me where to save before each download"
                      AutomationProperties.Name="Ask before each download"
                      Margin="0,16,0,0"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Concurrent downloads" Margin="0,20,0,6"/>
            <StackPanel Orientation="Horizontal">
              <Slider x:Name="ConcurrencySlider" Style="{StaticResource ArcadeSlider}"
                      Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
                      TickPlacement="BottomRight"
                      Width="200" VerticalAlignment="Center"
                      AutomationProperties.Name="Concurrent downloads"/>
              <TextBlock x:Name="ConcurrencyLabel" Foreground="{StaticResource TextMuted}"
                         FontFamily="__GRAB_FONTS__#VT323" FontSize="14"
                         VerticalAlignment="Center" Margin="12,0,0,0" Text="3"/>
            </StackPanel>

            <!-- Cookies section -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="COOKIES"/>
            <Border Height="1" Background="{StaticResource Cyan}" Opacity="0.35" Margin="0,-4,0,10"/>
            <TextBlock Style="{StaticResource FieldLabel}"
                       Text="Browser used to read login cookies (needed for private links)"/>
            <ComboBox x:Name="CookieBrowser" Style="{StaticResource ArcadeCombo}" Width="180" HorizontalAlignment="Left"
                      AutomationProperties.Name="Cookie browser">
              <ComboBoxItem Content="chrome"/>
              <ComboBoxItem Content="firefox"/>
              <ComboBoxItem Content="edge"/>
              <ComboBoxItem Content="brave"/>
              <ComboBoxItem Content="none"/>
            </ComboBox>
            <TextBlock Style="{StaticResource Caption}"
                       Text="GRAB reads cookies from THIS browser so links behind logins (Instagram, private videos, etc.) work. Pick the browser you're logged into."/>

            <!-- Video section -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="VIDEO"/>
            <Border Height="1" Background="{StaticResource Cyan}" Opacity="0.35" Margin="0,-4,0,10"/>
            <TextBlock Style="{StaticResource FieldLabel}"
                       Text="Preferred video quality (yt-dlp only)"/>
            <ComboBox x:Name="VideoQuality" Style="{StaticResource ArcadeCombo}" Width="180" HorizontalAlignment="Left"
                      AutomationProperties.Name="Preferred video quality">
              <ComboBoxItem Content="best"/>
              <ComboBoxItem Content="2160p"/>
              <ComboBoxItem Content="1440p"/>
              <ComboBoxItem Content="1080p"/>
              <ComboBoxItem Content="720p"/>
              <ComboBoxItem Content="480p"/>
              <ComboBoxItem Content="audio"/>
            </ComboBox>
            <TextBlock Style="{StaticResource Caption}"
                       Text="Falls back to next-best if the exact resolution isn't available."/>

            <!-- Notifications section -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="NOTIFICATIONS"/>
            <Border Height="1" Background="{StaticResource Cyan}" Opacity="0.35" Margin="0,-4,0,10"/>
            <CheckBox x:Name="ToastsEnabled" Style="{StaticResource ArcadeCheck}"
                      Content="Show a Windows toast when a download completes or fails"
                      AutomationProperties.Name="Toast notifications"/>

            <!-- Clipboard section -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="CLIPBOARD"/>
            <Border Height="1" Background="{StaticResource Cyan}" Opacity="0.35" Margin="0,-4,0,10"/>
            <CheckBox x:Name="ClipboardWatch" Style="{StaticResource ArcadeCheck}"
                      Content="Watch the clipboard and offer to grab when I copy a URL"
                      AutomationProperties.Name="Clipboard watch"/>

            <!-- Display section (arcade cabinet effects) -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="DISPLAY"/>
            <Border Height="1" Background="{StaticResource Cyan}" Opacity="0.35" Margin="0,-4,0,10"/>
            <CheckBox x:Name="CrtScanlines" Style="{StaticResource ArcadeCheck}"
                      Content="CRT scanlines overlay (arcade cabinet look)"
                      AutomationProperties.Name="CRT scanlines overlay"/>

            <!-- Safety section -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="SAFETY / PRIVACY"/>
            <Border Height="1" Background="{StaticResource Cyan}" Opacity="0.35" Margin="0,-4,0,10"/>
            <TextBlock Style="{StaticResource FieldLabel}"
                       Text="Sensitive downloads route into a hidden .private/ folder (Windows Hidden attribute)."/>
            <CheckBox x:Name="SensitiveByDefault" Style="{StaticResource ArcadeCheck}"
                      Content="Treat EVERY download as sensitive"
                      AutomationProperties.Name="Treat every download as sensitive"
                      Margin="0,4,0,10"/>
            <TextBlock Style="{StaticResource FieldLabel}"
                       Text="Auto-sensitive URL patterns (one per line, substring, case-insensitive)"
                       Margin="0,10,0,6"/>
            <Border CornerRadius="4"
                    Background="{StaticResource CardHi}"
                    BorderBrush="{StaticResource Cyan}"
                    BorderThickness="1">
              <!-- Audit v0.3.0-pass2 finding 5: AcceptsTab="False" so Tab
                   moves focus out (a11y) instead of inserting a \t. -->
              <TextBox x:Name="SensitiveSites"
                       Background="Transparent"
                       Foreground="{StaticResource Text}"
                       BorderThickness="0"
                       CaretBrush="#FF2D8C"
                       SelectionBrush="#FF2D8C"
                       SelectionOpacity="0.35"
                       FontFamily="__GRAB_FONTS__#Inter"
                       FontSize="12"
                       Padding="10,7"
                       Height="110"
                       TextWrapping="NoWrap"
                       AcceptsReturn="True"
                       AcceptsTab="False"
                       AutomationProperties.Name="Sensitive URL patterns"
                       VerticalScrollBarVisibility="Auto"/>
            </Border>
            <TextBlock Style="{StaticResource Caption}"
                       Text="Example: nhentai.net, allporncomic.com, e-hentai.org"/>

            <!-- Audit P2-53: test-a-URL input. Type any URL here and click
                 TEST to preview whether the current patterns above would
                 flag it as sensitive. Never queues anything. -->
            <TextBlock Style="{StaticResource FieldLabel}"
                       Text="Test a URL against the patterns above:"
                       Margin="0,12,0,6"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" CornerRadius="4"
                      Background="{StaticResource CardHi}"
                      BorderBrush="{StaticResource Cyan}"
                      BorderThickness="1">
                <TextBox x:Name="SensitiveTestUrl"
                         Background="Transparent"
                         Foreground="{StaticResource Text}"
                         BorderThickness="0"
                         CaretBrush="#FF2D8C"
                         SelectionBrush="#FF2D8C"
                         SelectionOpacity="0.35"
                         FontFamily="__GRAB_FONTS__#Inter"
                         FontSize="12"
                         Padding="10,7"
                         AutomationProperties.Name="Test URL against patterns"/>
              </Border>
              <Button Grid.Column="1" x:Name="SensitiveTestBtn"
                      Style="{StaticResource ArcadeGhost}"
                      Content="TEST"
                      Width="80"
                      Margin="8,0,0,0"
                      AutomationProperties.Name="Run sensitive-pattern test"/>
            </Grid>
            <TextBlock x:Name="SensitiveTestResult"
                       Foreground="{StaticResource TextMuted}"
                       FontFamily="__GRAB_FONTS__#VT323"
                       FontSize="12"
                       Margin="0,6,0,0"/>

            <!-- Startup section -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="STARTUP"/>
            <Border Height="1" Background="{StaticResource Cyan}" Opacity="0.35" Margin="0,-4,0,10"/>
            <CheckBox x:Name="Autostart" Style="{StaticResource ArcadeCheck}"
                      Content="Launch grab automatically when Windows starts"
                      AutomationProperties.Name="Launch at Windows startup"/>

            <!-- About -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="ABOUT"/>
            <Border Height="1" Background="{StaticResource Cyan}" Opacity="0.35" Margin="0,-4,0,10"/>
            <!-- Audit v0.3.0-pass2 finding 79: default text is generic
                 "grab" (was hardcoded "grab v0.1.0"). Real version stamp is
                 bound in Show-Settings so the About block never drifts. -->
            <TextBlock x:Name="VersionLabel" Foreground="{StaticResource TextMuted}"
                       FontFamily="__GRAB_FONTS__#VT323" FontSize="14"
                       Text="grab"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="OpenStateBtn" Style="{StaticResource ArcadeGhost}" Content="OPEN APP-DATA FOLDER"
                      AutomationProperties.Name="Open app-data folder"/>
              <Button x:Name="OpenLogsBtn"  Style="{StaticResource ArcadeGhost}" Content="OPEN LOGS" Margin="8,0,0,0"
                      AutomationProperties.Name="Open logs folder"/>
            </StackPanel>

            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,26,0,0"/>

            <Button x:Name="ResetBtn" Style="{StaticResource ArcadeDanger}"
                    Content="RESET ALL TO DEFAULTS"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Reset all settings to defaults"
                    Margin="0,20,0,20"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Action row -->
        <Grid Grid.Row="2" Margin="24,12,24,20">
          <TextBlock x:Name="StatusLine" Foreground="{StaticResource TextDim}"
                     FontFamily="__GRAB_FONTS__#Inter" FontSize="11"
                     VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Style="{StaticResource ArcadeGhost}" Content="CANCEL" Width="100" Margin="0,0,8,0"
                    IsCancel="True"
                    AutomationProperties.Name="Cancel (Esc)"/>
            <Button x:Name="SaveBtn"   Style="{StaticResource ArcadePrimary}" Content="SAVE"   Width="130"
                    IsDefault="True"
                    AutomationProperties.Name="Save settings"/>
          </StackPanel>
        </Grid>
      </Grid>
      </Border>
    </Border>

    <!-- Static CRT scanlines overlay. See popup.xaml for the pattern. -->
    <Rectangle x:Name="ScanlinesOverlay"
               IsHitTestVisible="False"
               Panel.ZIndex="999"
               Opacity="0.14">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,3"
                             MappingMode="Absolute" SpreadMethod="Repeat">
          <GradientStop Offset="0"    Color="#40FFFFFF"/>
          <GradientStop Offset="0.5"  Color="#40FFFFFF"/>
          <GradientStop Offset="0.5"  Color="#00000000"/>
          <GradientStop Offset="1"    Color="#00000000"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

  </Grid>
</Window>

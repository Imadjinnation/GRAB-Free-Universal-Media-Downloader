<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="grab"
        Width="480" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        MinWidth="380" MinHeight="340"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <!-- Palette -->
    <SolidColorBrush x:Key="Bg"          Color="#111114"/>
    <SolidColorBrush x:Key="BgSoft"      Color="#1A1A1D"/>
    <SolidColorBrush x:Key="BorderSoft"  Color="#26262A"/>
    <SolidColorBrush x:Key="BorderInput" Color="#2A2A2E"/>
    <SolidColorBrush x:Key="Text"        Color="#F5F5F7"/>
    <SolidColorBrush x:Key="TextMuted"   Color="#8E8E93"/>
    <SolidColorBrush x:Key="TextDim"     Color="#5E5E63"/>
    <SolidColorBrush x:Key="Hover"       Color="#1F1F23"/>
    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F5A87A" Offset="0"/>
      <GradientStop Color="#E85F62" Offset="1"/>
    </LinearGradientBrush>

    <!-- Icon button (title bar min/close) -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Close (× - want a red hover) -->
    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#8A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tab button -->
    <Style x:Key="TabBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <ContentPresenter x:Name="CP" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
              <Border x:Name="Under" Height="2" VerticalAlignment="Bottom" Margin="10,0" Background="Transparent" CornerRadius="1"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter TargetName="Under" Property="Background" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Primary button (gradient) -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="9" Background="{StaticResource Accent}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ghost button -->
    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Outer border: rounded, dark, drop shadow -->
  <Border CornerRadius="14"
          Background="{StaticResource Bg}"
          BorderBrush="{StaticResource BorderSoft}"
          BorderThickness="1"
          Margin="14">
    <Border.Effect>
      <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>   <!-- title bar -->
        <RowDefinition Height="40"/>   <!-- tab strip -->
        <RowDefinition Height="*"/>    <!-- tab content -->
      </Grid.RowDefinitions>

      <!-- ===== Title bar =====
           Background="#01000000" is nearly-transparent BUT guaranteed
           hit-testable so MouseLeftButtonDown fires anywhere on the bar
           (drag-to-move). "Transparent" also works in theory but is
           less reliable across WPF versions. -->
      <Grid Grid.Row="0" x:Name="TitleBar" Background="#01000000" Margin="12,0,4,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
          <TextBlock Text="grab"
                     FontFamily="Segoe UI Variable Display, Segoe UI"
                     FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource Text}"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="MinBtn"   Style="{StaticResource IconBtn}"  Content="&#8211;"/>
          <Button x:Name="CloseBtn" Style="{StaticResource CloseBtn}" Content="&#215;" Margin="4,0,0,0"/>
        </StackPanel>
      </Grid>

      <!-- ===== Tab strip ===== -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
        <Button x:Name="TabPaste"  Style="{StaticResource TabBtn}" Content="Paste"  Tag="active"/>
        <Button x:Name="TabQueue"  Style="{StaticResource TabBtn}" Content="Queue"/>
        <Button x:Name="TabRecent" Style="{StaticResource TabBtn}" Content="Recent"/>
      </StackPanel>

      <!-- ===== Tab content ===== -->
      <Grid Grid.Row="2" Margin="20,10,20,20">
        <!-- Paste tab -->
        <Grid x:Name="PastePanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="Paste any link. We'll figure out the rest."
                     FontFamily="Segoe UI Variable Text, Segoe UI"
                     FontSize="13"
                     Foreground="{StaticResource TextMuted}"/>

          <!-- Single-line input (visible by default) -->
          <Border Grid.Row="1"
                  x:Name="SingleInputBorder"
                  CornerRadius="10"
                  Background="{StaticResource BgSoft}"
                  BorderBrush="{StaticResource BorderInput}"
                  BorderThickness="1"
                  Margin="0,14,0,0">
            <TextBox x:Name="UrlBox"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource Text}"
                     CaretBrush="#F5A87A"
                     SelectionBrush="#F5A87A"
                     SelectionOpacity="0.35"
                     FontSize="13"
                     FontFamily="Consolas, Segoe UI"
                     Padding="16,13"
                     VerticalContentAlignment="Center"/>
          </Border>

          <!-- Multi-line input (hidden by default) -->
          <Border Grid.Row="1"
                  x:Name="MultiInputBorder"
                  CornerRadius="10"
                  Background="{StaticResource BgSoft}"
                  BorderBrush="{StaticResource BorderInput}"
                  BorderThickness="1"
                  Margin="0,14,0,0"
                  Visibility="Collapsed">
            <TextBox x:Name="MultiBox"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource Text}"
                     CaretBrush="#F5A87A"
                     SelectionBrush="#F5A87A"
                     SelectionOpacity="0.35"
                     FontSize="13"
                     FontFamily="Consolas, Segoe UI"
                     Padding="16,10"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="140"
                     VerticalScrollBarVisibility="Auto"/>
          </Border>

          <TextBlock Grid.Row="2"
                     x:Name="Hint"
                     FontSize="11"
                     Foreground="{StaticResource TextDim}"
                     Margin="4,10,0,0"/>

          <!-- Actions row -->
          <Grid Grid.Row="4" Margin="0,16,0,0">
            <Button x:Name="ToggleMulti"
                    Style="{StaticResource GhostBtn}"
                    Content="Add many..."
                    HorizontalAlignment="Left"/>
            <Button x:Name="GrabBtn"
                    Style="{StaticResource PrimaryBtn}"
                    Content="Grab it"
                    Width="120"
                    HorizontalAlignment="Right"/>
          </Grid>

          <TextBlock Grid.Row="5"
                     x:Name="StatusLine"
                     FontSize="11"
                     Foreground="{StaticResource TextDim}"
                     Margin="4,12,0,0"
                     TextWrapping="Wrap"/>
        </Grid>

        <!-- Queue tab -->
        <Grid x:Name="QueuePanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="QueueList" Margin="0,0,4,0"/>
          </ScrollViewer>
          <TextBlock Grid.Row="0"
                     x:Name="QueueEmpty"
                     Text="Nothing in the queue. Paste a link on the Paste tab."
                     Foreground="{StaticResource TextMuted}"
                     FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="Collapsed"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="QueueClearDone" Style="{StaticResource GhostBtn}" Content="Clear finished"/>
          </StackPanel>
        </Grid>

        <!-- Recent tab -->
        <Grid x:Name="RecentPanel" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RecentList" Margin="0,0,4,0"/>
          </ScrollViewer>
          <TextBlock x:Name="RecentEmpty"
                     Text="No recent downloads yet."
                     Foreground="{StaticResource TextMuted}"
                     FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
